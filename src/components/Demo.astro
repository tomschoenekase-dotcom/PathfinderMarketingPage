---
---

<section id="demo" class="py-24 bg-surface">
  <div class="max-w-4xl mx-auto px-5 text-center">
    <span class="inline-block bg-brand/10 text-brand text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-4">
      See It in Action
    </span>
    <h2 class="text-3xl md:text-4xl font-extrabold text-navy mb-4">
      PathFinder in a real venue
    </h2>
    <p class="text-navy/60 text-lg max-w-xl mx-auto mb-12">
      A short walkthrough of how visitors interact with PathFinder at an actual site — from QR scan to answered question.
    </p>

    <!-- Placeholder card -->
    <div
      class="relative bg-white border-2 border-dashed border-steel rounded-3xl overflow-hidden aspect-video flex items-center justify-center mb-10"
    >
      <!-- Decorative background grid -->
      <div class="absolute inset-0 opacity-30"
        style="background-image: linear-gradient(#C9D4E3 1px, transparent 1px), linear-gradient(to right, #C9D4E3 1px, transparent 1px); background-size: 32px 32px;">
      </div>

      <div class="relative z-10 flex flex-col items-center gap-4 text-navy/40">
        <!-- Play button -->
        <div class="w-16 h-16 rounded-full bg-brand/10 border border-brand/20 flex items-center justify-center">
          <svg class="w-7 h-7 text-brand ml-1" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </div>
        <div class="text-sm font-medium text-navy/50">Demo video coming soon</div>
        <div class="text-xs text-navy/35 max-w-xs">
          Real screenshots and a live demo will be added here. Contact us to request a walkthrough.
        </div>
      </div>
    </div>

    <a
      href="#contact"
      class="inline-block bg-accent hover:bg-brand text-white font-semibold px-8 py-4 rounded-xl transition-colors shadow-md"
    >
      Request a Live Demo
    </a>
  </div>
</section>
